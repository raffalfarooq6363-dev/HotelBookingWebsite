  "components": {
    "schemas": {
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "nullable": true
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "additionalProperties": false
      },
      "Booking": {
        "required": [
          "checkIn",
          "checkOut",
          "email",
          "firstName",
          "lastName",
          "roomId",
          "roomName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          },
          "roomId": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "roomName": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "destinationName": {
            "maxLength": 150,
            "type": "string",
            "nullable": true
          },
          "roomImage": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "pricePerNight": {
            "type": "number",
            "format": "double"
          },
          "checkIn": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "checkOut": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "nights": {
            "type": "integer",
            "format": "int32"
          },
          "guests": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "selectedAddons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "firstName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "phone": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          },
          "specialRequests": {
            "maxLength": 1000,
            "type": "string",
            "nullable": true
          },
          "paymentMethod": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          },
          "totalAmountUSD": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "maxLength": 10,
            "type": "string",
            "nullable": true
          },
          "currencySymbol": {
            "maxLength": 10,
            "type": "string",
            "nullable": true
          },
          "convertedTotal": {
